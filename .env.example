# ── .env.example ──────────────────────────────────────────────────────────────
# Bu dosyayı '.env' olarak kopyalayıp değerleri doldurun. '.env' ASLA git'e
# eklenmemelidir (.gitignore'da zaten hariç tutulmuş).

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=Tubitak_Dokumanlar_Hybrid

# Gömme (embedding) modeli
EMBED_MODEL=ytu-ce-cosmos/turkish-e5-large

# RAG parametreleri
RAG_TOP_K=5
RAG_THRESHOLD=0.3

# ── Kimlik Doğrulama (JWT / RS256) ──────────────────────────────────────────
# ÖZEL anahtar bizde ASLA bulunmaz — yalnızca Bilimp'te kalır. Biz sadece
# doğrulama için GENEL anahtarı tutarız.
JWT_ALGORITHM=RS256
JWT_ISSUER=bilimp-teracity
# Kullanıcı token'ları (POST /query) için beklenen 'aud':
JWT_AUDIENCE_QUERY=tubitak1505-query
# Servis token'ları (hedef kitle yönetimi uçları) için beklenen 'aud':
JWT_AUDIENCE_ADMIN=tubitak1505-audience-admin
# iat/exp doğrulamasında tolerans (saniye):
JWT_CLOCK_SKEW_SECONDS=30

# Tek anahtarlı basit kurulum (rotasyon yoksa):
JWT_PUBLIC_KEY=

# Anahtar rotasyonu için çoklu genel anahtar haritası (opsiyonel, JSON):
# JWT_PUBLIC_KEYS_JSON={"kid-2026-01": "-----BEGIN PUBLIC KEY-----..."}

# ── LLM sağlayıcı: "gemini" | "ollama" ──────────────────────────────────────
LLM_PROVIDER=ollama
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama kullanılıyorsa (LLM_PROVIDER=ollama):
OLLAMA_MODEL=gemma3:4b
# ÖNEMLİ: container içinden host'ta çalışan Ollama'ya "localhost" ile ulaşılamaz.
# Docker Desktop'ın host'a özel adresi kullanılmalı:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Rate Limiting (Faz 4 / madde 15) ────────────────────────────────────────
# Bellek-içi, tek-örnekli dağıtım için. Çok-örnekli ölçeklemede Redis-destekli
# bir sürüme geçilmesi önerilir (bkz. rate_limiting.py başlığı).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60