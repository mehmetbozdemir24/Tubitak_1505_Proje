FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Uygulama kaynakları
COPY abac.py auth.py tenancy.py api_schemas.py audience_service.py \
     rag_service.py document_ingestion_service.py chunker.py \
     error_handling.py rate_limiting.py \
     prompts.py language_utils.py api.py ./

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]